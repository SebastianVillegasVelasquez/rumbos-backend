# Copy to .env and fill in real values. .env is never committed.

# Async SQLAlchemy URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://rumbos:rumbos@localhost:5435/rumbos

# Moodle instance this service proxies Web Services calls to
MOODLE_BASE_URL=https://moodle.example.com
# Moodle Web Services token. Stays server-side, never exposed to the frontend.
MOODLE_SERVICE_TOKEN=changeme

# Timeouts (seconds) for calls to Moodle. Optional; defaults shown.
MOODLE_CONNECT_TIMEOUT=5
MOODLE_READ_TIMEOUT=15

# Browser origins allowed to call this API, comma-separated. Optional; empty
# (the default) adds no CORS middleware. The dev frontend uses a Vite proxy and
# needs nothing here; set it for a deployment where the frontend is served from
# another origin, e.g. https://rumbos.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# In-process cache of Moodle course contents. Optional; defaults shown.
# Seconds a cached copy is served without asking Moodle again...
MOODLE_CONTENTS_TTL_SECONDS=60
# ...and how old a copy may be and still be served (as "cached") when Moodle fails.
MOODLE_STALE_MAX_SECONDS=3600
