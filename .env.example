# Copy to .env and fill in real values. .env is never committed.

# PostgreSQL connection. The async SQLAlchemy URL (asyncpg) is built from these.
# The db service in compose.dev.yaml also reads USER, PASSWORD and DB.
POSTGRES_USER=rumbos
POSTGRES_PASSWORD=rumbos
POSTGRES_DB=rumbos
# Optional; defaults are localhost and 5432. From the host, compose publishes 5435;
# inside the compose network use POSTGRES_HOST=db and POSTGRES_PORT=5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5435

# Moodle instance this service proxies Web Services calls to
MOODLE_BASE_URL=https://moodle.example.com
# Moodle Web Services token. Stays server-side, never exposed to the frontend.
MOODLE_SERVICE_TOKEN=changeme

# Timeouts (seconds) for calls to Moodle. Optional; defaults shown.
MOODLE_CONNECT_TIMEOUT=5
MOODLE_READ_TIMEOUT=15

# Browser origins allowed to call this API, comma-separated. Optional; empty
# (the default) adds no CORS middleware. The dev frontend uses a Vite proxy and
# needs nothing here; set it for a deployment where the frontend is served from
# another origin, e.g. https://rumbos.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# In-process cache of Moodle course contents. Optional; defaults shown.
# Seconds a cached copy is served without asking Moodle again...
MOODLE_CONTENTS_TTL_SECONDS=60
# ...and how old a copy may be and still be served (as "cached") when Moodle fails.
MOODLE_STALE_MAX_SECONDS=3600

# Image uploads (backgrounds and bubble images). There is NO authentication yet,
# so the upload endpoint is anonymous: the limits below only bound the damage.
# Leave this false on any deployment reachable from the internet.
ASSETS_UPLOADS_ENABLED=false
# Directory for the stored files. It MUST be persistent: in a container, mount a
# volume on it (README, "Persistent storage"), or every deployment loses the
# uploads. In the container image use /data/assets. Optional; default shown.
ASSETS_DIR=data/assets
# true: refuse to start when the directory does not match the database (an
# unmounted or replaced volume). false: start, log an ERROR, report
# `storage: "degraded"` on /health/ready and refuse uploads.
STORAGE_FAIL_FAST=false
ASSETS_MAX_BACKGROUND_BYTES=8388608
ASSETS_MAX_BUBBLE_BYTES=2097152
ASSETS_MAX_BACKGROUND_SIDE=8192
ASSETS_MAX_BUBBLE_SIDE=1024
ASSETS_MAX_IMAGE_BYTES=4194304
ASSETS_MAX_IMAGE_SIDE=2048
# Sum of every stored file; over it, uploads answer 507.
ASSETS_MAX_TOTAL_BYTES=2147483648

# Audio: editors uploading their own music for maps. Music is a copyright
# exposure, so this has its own switch. Unset: true when APP_ENV=dev, false when
# APP_ENV=production. It blocks only uploading; playing tracks and choosing
# library tracks never depend on it. See the README ("Music").
# AUDIO_UPLOADS_ENABLED=false
ASSETS_MAX_AUDIO_BYTES=8388608
# Longest accepted track, in seconds.
ASSETS_MAX_AUDIO_SECONDS=600

# Publications kept per map (older ones are pruned when a new one is published;
# the latest is never pruned). Optional; default shown.
PUBLICATIONS_KEEP=20

# --- Authentication (see the README, "Tenants and authentication") ---
# dev | production. Only decides the default of LEGACY_ANONYMOUS_MODE.
APP_ENV=dev
# Serve requests without a bearer token anonymously, as the "legacy" tenant
# (the standalone deployment that talks to Moodle with MOODLE_SERVICE_TOKEN).
# Unset: true in dev, false in production. Turn it off once the plugin replaces it.
# LEGACY_ANONYMOUS_MODE=false
# The audience launch assertions must carry.
AUTH_AUDIENCE=rumbos
# Bearer token lifetime (seconds) and tolerated clock skew for assertions (max 30).
ACCESS_TOKEN_TTL_SECONDS=1800
LAUNCH_LEEWAY_SECONDS=30
# /auth/launch attempts per minute, per client address and per tenant. Kept in
# each worker's memory (not shared between WORKERS).
LAUNCH_RATE_PER_IP=30
LAUNCH_RATE_PER_TENANT=300
