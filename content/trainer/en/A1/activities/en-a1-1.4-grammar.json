        {
          "id": "l2",
          "text": "15"
        },
        {
          "id": "l3",
          "text": "20"
        },
        {
          "id": "l4",
          "text": "40"
        }
      ],
      "right": [
        {
          "id": "r1",
          "text": "twelve"
        },
        {
          "id": "r2",
          "text": "fifteen"
        },
        {
          "id": "r3",
          "text": "twenty"
        },
        {
          "id": "r4",
          "text": "forty"
        }
      ],
      "pairs": [
        [
          "l1",
          "r1"
        ],
        [
          "l2",
          "r2"
        ],
        [
          "l3",
          "r3"
        ],
        [
          "l4",
          "r4"
        ]
      ],
      "explanation": "Learn the teens and the tens."
    },
    {
      "id": "1.4.ex.06",
      "type": "short_answer",
      "prompt": "Say your age. You are 30.",
      "accepted": [
        "I am thirty",
        "I am 30",
        "I am thirty years old",
        "I am 30 years old",
        "I'm thirty",
        "I'm 30"
      ],
      "explanation": "I am + number.",
      "error_tag": {
        "tag": "be_age",
        "text": "Use I am + number."
      }
    }
