    {
      "id": "b1-1.3.ex.01",
      "type": "mcq",
      "prompt": "Which sentence is correct?",
      "options": [
        {
          "id": "o1",
          "text": "The hotel is as bigger as the old palace."
        },
        {
          "id": "o2",
          "text": "The hotel is more big than the old palace."
        },
        {
          "id": "o3",
          "text": "The hotel is as big as the old palace."
        }
      ],
      "correct": "o3",
      "explanation": "Use as + adjective + as. Do not add -er inside as ... as.",
      "error_tags": {
        "o1": {
          "tag": "as_as",
          "text": "Use the basic adjective between as and as."
        },
        "o2": {
          "tag": "as_as",
          "text": "Use the basic adjective between as and as."
        }
      }
    },
    {
      "id": "b1-1.3.ex.02",
      "type": "gap_fill",
      "prompt": "Choose the correct form.",
      "template": "The beach is {1} than the lake.",
      "gaps": [
        {
          "gap_id": "1",
          "options": [
            {
              "id": "o1",
              "text": "cleaner"
            },
            {
              "id": "o2",
              "text": "more clean"
            },
            {
              "id": "o3",
              "text": "cleanest"
            }
          ],
          "correct": "o1",
          "error_tag": {
            "tag": "comparative_form",
            "text": "Add -er to short adjectives."
          }
        }
      ],
      "explanation": "Short adjectives take -er than: cleaner than."
    },
