    {
      "id": "b1-1.4.ex.01",
      "type": "mcq",
      "prompt": "Which sentence is a plan that is already arranged?",
      "options": [
        {
          "id": "o1",
          "text": "We meet the caterers at nine, maybe."
        },
        {
          "id": "o2",
          "text": "We are meeting the caterers at nine."
        },
        {
          "id": "o3",
          "text": "We will to meet the caterers at nine."
        }
      ],
      "correct": "o2",
      "explanation": "The present continuous talks about a fixed arrangement.",
      "error_tags": {
        "o1": {
          "tag": "future_form",
          "text": "Use be + -ing for arranged plans."
        },
        "o3": {
          "tag": "future_form",
          "text": "Use be + -ing for arranged plans."
        }
      }
    },
    {
      "id": "b1-1.4.ex.02",
      "type": "gap_fill",
      "prompt": "Choose the correct form.",
      "template": "We {1} the party to Sunday. I'm very sorry.",
      "gaps": [
        {
          "gap_id": "1",
          "options": [
            {
              "id": "o1",
              "text": "has moved"
            },
            {
              "id": "o2",
              "text": "move"
            },
            {
              "id": "o3",
              "text": "have moved"
            }
          ],
          "correct": "o3",
          "error_tag": {
            "tag": "present_perfect",
            "text": "We takes have, not has."
          }
        }
      ],
      "explanation": "Use the present perfect (have moved) for a change that matters now."
    },
    {
      "id": "b1-1.4.ex.03",
