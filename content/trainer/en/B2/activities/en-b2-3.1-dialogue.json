        "mode": "choose",
        "options": [
          {
            "id": "o1",
            "text": "Visitors are asked to keep to the paths.",
            "next": "n4"
          },
          {
            "id": "o2",
            "text": "Please note that numbers are limited each day.",
            "next": "n4"
          },
