      "prompt": "Which sentence uses a modal in the passive?",
      "options": [
        {
          "id": "o1",
          "text": "Guests may change the dates."
        },
        {
          "id": "o2",
          "text": "The dates may be changed."
        },
        {
          "id": "o3",
          "text": "The dates change quickly."
        }
      ],
      "correct": "o2",
      "explanation": "A modal in the passive is modal + be + past participle: may be changed.",
      "error_tags": {
        "o1": {
          "tag": "voice",
          "text": "This is active: guests do the action."
        },
        "o3": {
          "tag": "voice",
          "text": "This has no modal and no passive."
        }
      }
    },
