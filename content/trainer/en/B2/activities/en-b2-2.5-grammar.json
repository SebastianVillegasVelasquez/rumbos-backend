      "type": "mcq",
      "prompt": "Which sentence is correct for reporting a theft?",
      "options": [
        {
          "id": "o1",
          "text": "Somebody stole my passport yesterday, I think."
        },
        {
          "id": "o2",
          "text": "My passport was stolen yesterday."
        },
        {
          "id": "o3",
          "text": "My passport has stolen yesterday."
        }
      ],
      "correct": "o2",
      "explanation": "The past passive is was/were + past participle: was stolen.",
      "error_tags": {
        "o3": {
          "tag": "voice",
          "text": "Has stolen is not a passive form."
        }
      }
    },
