  "items": [
    {
      "id": "b2-1.3.ex.01",
      "type": "mcq",
      "prompt": "Which sentence describes a problem that is still going on?",
      "options": [
        {
          "id": "o1",
          "text": "The operator cancelled our booking yesterday."
        },
        {
          "id": "o2",
          "text": "The operator has been cancelling our bookings all week."
        },
        {
          "id": "o3",
          "text": "The operator will cancel our booking tomorrow."
        }
      ],
      "correct": "o2",
      "explanation": "The present perfect continuous links a repeated action to now.",
      "error_tags": {
        "o1": {
          "tag": "tense",
          "text": "The past simple finishes the action in the past."
        },
        "o3": {
          "tag": "tense",
          "text": "Will cancel is about the future."
        }
      }
    },
    {
      "id": "b2-1.3.ex.02",
      "type": "gap_fill",
      "prompt": "Choose the correct form.",
      "template": "We {1} waiting for a reply since Monday.",
      "gaps": [
        {
          "gap_id": "1",
          "options": [
            {
              "id": "o1",
              "text": "have been"
            },
            {
              "id": "o2",
              "text": "are"
            },
            {
              "id": "o3",
              "text": "were"
            }
          ],
          "correct": "o1",
          "error_tag": {
            "tag": "tense",
            "text": "Since Monday needs the present perfect continuous."
          }
        }
      ],
      "explanation": "Since + a starting point goes with have been waiting."
    },
    {
      "id": "b2-1.3.ex.03",
      "type": "gap_fill",
      "prompt": "Type the missing word.",
      "template": "I am writing to {1} an urgent review of the account.",
      "gaps": [
        {
          "gap_id": "1",
          "accepted": [
            "request",
            "ask for"
          ],
          "error_tag": {
            "tag": "register",
            "text": "Use a formal verb such as request."
          }
        }
      ],
      "explanation": "I am writing to request is a formal opening for a complaint."
    },
    {
      "id": "b2-1.3.ex.04",
      "type": "reorder",
      "prompt": "Put the words in order.",
      "tokens": [
