      {
        "id": "n3",
        "partner_line": "Is there a legend connected with the bridge?",
        "translation": "¿Hay alguna leyenda relacionada con el puente?",
        "audio": "en-b2-3.2.d3",
        "mode": "choose",
        "options": [
          {
            "id": "o1",
            "text": "Yes. It is said that a ghost guards it at night.",
            "next": "n4"
          },
          {
            "id": "o2",
            "text": "There is one about a lost treasure under the arch.",
            "next": "n4"
          },
          {
            "id": "o3",
            "text": "Locals say the bridge was built in a single night.",
            "next": "n4"
          }
        ]
      },
      {
        "id": "n4",
        "partner_line": "How did the legend start?",
        "translation": "¿Cómo comenzó la leyenda?",
        "audio": "en-b2-3.2.d4",
        "mode": "choose",
        "options": [
          {
            "id": "o1",
            "text": "A traveller had disappeared, and people claimed to have seen his light.",
            "next": "n5"
          },
          {
            "id": "o2",
            "text": "When the flood came, a boatman had saved twelve children.",
            "next": "n5"
          },
          {
            "id": "o3",
            "text": "Nobody remembers; it was passed down by word of mouth.",
            "next": "n5"
          }
        ]
      },
      {
        "id": "n5",
        "partner_line": "Is the bridge protected today?",
        "translation": "¿El puente está protegido hoy?",
        "audio": "en-b2-3.2.d5",
        "mode": "choose",
        "options": [
          {
            "id": "o1",
            "text": "Yes, it was declared a heritage site some years ago.",
            "next": "n6"
          },
          {
            "id": "o2",
            "text": "It has been restored twice and is now closed to traffic.",
            "next": "n6"
          },
          {
            "id": "o3",
            "text": "It is protected, and visitors are asked not to climb on it.",
            "next": "n6"
          }
