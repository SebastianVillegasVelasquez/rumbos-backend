        "audio": "en-b2-3.3.d1",
        "mode": "choose",
        "options": [
          {
            "id": "o1",
            "text": "Certainly. The main building has been completed.",
            "next": "n2"
          },
          {
            "id": "o2",
            "text": "We are on schedule. Two milestones have been reached.",
            "next": "n2"
          },
          {
            "id": "o3",
            "text": "Progress is good, although one task is still pending.",
            "next": "n2"
          }
        ]
      },
      {
        "id": "n2",
        "partner_line": "What is still left to do?",
        "translation": "¿Qué falta por hacer?",
