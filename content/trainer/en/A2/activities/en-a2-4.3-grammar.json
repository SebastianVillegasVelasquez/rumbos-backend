  "items": [
    {
      "id": "a2-4.3.ex.01",
      "type": "mcq",
      "prompt": "Which sentence is a request?",
      "options": [
        {
          "id": "o1",
          "text": "Could I have a menu, please?"
        },
        {
          "id": "o2",
          "text": "I have a menu."
        },
        {
          "id": "o3",
          "text": "The menu is big."
        }
      ],
      "correct": "o1",
      "explanation": "Could I have ... please is a polite request.",
      "error_tags": {
        "o2": {
          "tag": "function",
          "text": "I have a menu states a fact; it asks for nothing."
        }
      }
    },
    {
      "id": "a2-4.3.ex.02",
      "type": "gap_fill",
      "prompt": "Choose the right word.",
      "template": "{1} I have some water, please?",
      "gaps": [
        {
          "gap_id": "1",
          "options": [
            {
              "id": "o1",
              "text": "Am"
            },
            {
              "id": "o2",
              "text": "Could"
            },
            {
              "id": "o3",
              "text": "Does"
            }
          ],
          "correct": "o2",
          "error_tag": {
            "tag": "modal",
            "text": "Use Could or Can to ask for something."
          }
        }
      ],
      "explanation": "Could I ... asks politely."
    },
    {
      "id": "a2-4.3.ex.03",
      "type": "gap_fill",
      "prompt": "Type the missing word.",
      "template": "I would {1} a coffee, please.",
      "gaps": [
        {
          "gap_id": "1",
          "accepted": [
            "like"
          ],
          "error_tag": {
            "tag": "modal",
            "text": "Say would like, not would want."
          }
        }
      ],
      "explanation": "I would like is the polite form."
    },
    {
      "id": "a2-4.3.ex.04",
      "type": "reorder",
      "prompt": "Put the words in order.",
      "tokens": [
        {
          "id": "t1",
          "text": "Could"
        },
        {
          "id": "t2",
          "text": "we"
        },
        {
          "id": "t3",
          "text": "have"
        },
        {
          "id": "t4",
          "text": "the"
        },
        {
          "id": "t5",
          "text": "bill"
        },
        {
          "id": "t6",
          "text": "please"
        }
      ],
      "explanation": "The request starts with Could.",
      "error_tag": {
        "tag": "word_order",
        "text": "Start with Could we."
      }
    },
    {
      "id": "a2-4.3.ex.05",
