        "options": [
          {
            "id": "o1",
            "text": "I'm sorry to hear that. Do you want some water?",
            "next": "n4"
          },
          {
            "id": "o2",
            "text": "Oh no. Please sit down.",
            "next": "n4"
          },
          {
            "id": "o3",
            "text": "Do you need a pharmacy?",
            "next": "n4"
          }
        ]
      },
      {
        "id": "n4",
        "partner_line": "It's cold here. I need a jacket.",
        "translation": "Hace frío. Necesito una chaqueta.",
