        "options": [
          {
            "id": "o1",
            "text": "There is a shop next to the station.",
            "next": "n5"
          },
          {
            "id": "o2",
            "text": "You can buy a jacket in the market.",
            "next": "n5"
          },
          {
            "id": "o3",
            "text": "We sell jackets here. What size?",
            "next": "n5"
          }
        ]
      },
      {
        "id": "n5",
        "partner_line": "What time do you get up every day?",
        "translation": "¿A qué hora te levantas todos los días?",
