  "items": [
    {
      "id": "a2-1.3.ex.01",
      "type": "mcq",
      "prompt": "Which sentence is correct?",
      "options": [
        {
          "id": "o1",
          "text": "I like swim."
        },
        {
          "id": "o2",
          "text": "I like to swimming."
        },
        {
          "id": "o3",
          "text": "I like swimming."
        }
      ],
      "correct": "o3",
      "explanation": "After like we can use a verb with -ing: I like swimming.",
      "error_tags": {
        "o1": {
          "tag": "verb_form",
          "text": "After like, add -ing to the verb."
        }
      }
    },
    {
      "id": "a2-1.3.ex.02",
      "type": "gap_fill",
      "prompt": "Choose the right word.",
      "template": "She enjoys {1} in the garden.",
