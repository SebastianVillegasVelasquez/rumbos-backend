        {
          "gap_id": "1",
          "options": [
            {
              "id": "o1",
              "text": "working"
            },
            {
              "id": "o2",
              "text": "work"
            },
            {
              "id": "o3",
              "text": "works"
            }
          ],
          "correct": "o1",
          "error_tag": {
            "tag": "verb_form",
            "text": "After enjoy, use the -ing form."
          }
        }
      ],
      "explanation": "After enjoy we use -ing: enjoys working."
    },
    {
      "id": "a2-1.3.ex.03",
      "type": "gap_fill",
      "prompt": "Type the verb in the -ing form: dance.",
