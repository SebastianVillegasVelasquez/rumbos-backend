        {
          "gap_id": "1",
          "accepted": [
            "dancing"
          ],
          "error_tag": {
            "tag": "spelling",
            "text": "Drop the final e before -ing: dancing."
          }
        }
      ],
      "explanation": "Dance loses the e: dancing."
    },
    {
