          "text": "the"
        },
        {
          "id": "t6",
          "text": "rain"
        }
      ],
      "explanation": "The order is: subject, enjoy, verb + -ing, place.",
      "error_tag": {
        "tag": "word_order",
        "text": "Start with They, then enjoy."
