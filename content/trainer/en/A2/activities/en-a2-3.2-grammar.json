{
  "id": "en-a2-3.2-grammar",
  "lesson_id": "3.2",
  "skill": "grammar",
  "title": "Practice 3.2",
  "estimated_minutes": 6,
  "status": "draft",
  "role": "Guide asking what guests can do",
  "can_do": [
    "I can say what I can and cannot do.",
    "I can ask someone what they can do."
  ],
  "items": [
    {
      "id": "a2-3.2.ex.01",
      "type": "mcq",
      "prompt": "Which sentence says an ability?",
      "options": [
        {
          "id": "o1",
          "text": "She cooked yesterday."
        },
        {
          "id": "o2",
          "text": "She can cook very well."
        },
        {
          "id": "o3",
          "text": "She is cooking now."
        }
      ],
      "correct": "o2",
      "explanation": "Can + verb says what someone is able to do.",
      "error_tags": {
        "o3": {
          "tag": "tense",
          "text": "Is cooking says what is happening now, not an ability."
        }
      }
    },
    {
      "id": "a2-3.2.ex.02",
      "type": "gap_fill",
      "prompt": "Choose the right word.",
      "template": "He {1} speak three languages.",
      "gaps": [
        {
          "gap_id": "1",
          "options": [
            {
              "id": "o1",
              "text": "is can"
            },
            {
              "id": "o2",
              "text": "does can"
            },
            {
              "id": "o3",
              "text": "can"
            }
          ],
          "correct": "o3",
          "error_tag": {
            "tag": "modal",
            "text": "Say he can, not he is can."
          }
        }
      ],
      "explanation": "After he we use can + verb, with no -s and no helper."
    },
    {
      "id": "a2-3.2.ex.03",
      "type": "gap_fill",
      "prompt": "Type the missing word.",
      "template": "I {1} swim, but I can run.",
      "gaps": [
        {
          "gap_id": "1",
          "accepted": [
            "can't",
            "cannot",
            "can not"
          ],
          "error_tag": {
            "tag": "negative",
            "text": "Use can't or cannot for what you are not able to do."
          }
        }
      ],
      "explanation": "I can't swim means I am not able to swim."
    },
    {
      "id": "a2-3.2.ex.04",
      "type": "reorder",
      "prompt": "Put the words in order.",
      "tokens": [
        {
          "id": "t1",
          "text": "Can"
        },
        {
          "id": "t2",
          "text": "you"
        },
        {
          "id": "t3",
          "text": "play"
        },
        {
          "id": "t4",
          "text": "the"
        },
        {
          "id": "t5",
          "text": "guitar"
        }
      ],
      "explanation": "The question starts with Can.",
      "error_tag": {
        "tag": "word_order",
        "text": "Start with Can, then you."
      }
    },
    {
      "id": "a2-3.2.ex.05",
      "type": "match",
      "prompt": "Match the verb with a thing.",
      "left": [
        {
          "id": "l1",
          "text": "swim"
        },
        {
          "id": "l2",
          "text": "ride"
        },
        {
          "id": "l3",
          "text": "cook"
        },
        {
          "id": "l4",
          "text": "speak"
        }
      ],
      "right": [
        {
          "id": "r1",
          "text": "in the sea"
        },
        {
          "id": "r2",
          "text": "a horse"
        },
        {
          "id": "r3",
          "text": "a meal"
        },
        {
          "id": "r4",
          "text": "English"
        }
      ],
      "pairs": [
        [
          "l1",
          "r1"
        ],
        [
          "l2",
          "r2"
        ],
        [
          "l3",
          "r3"
        ],
        [
          "l4",
          "r4"
        ]
      ],
      "explanation": "Each verb goes with its natural partner."
    },
    {
      "id": "a2-3.2.ex.06",
      "type": "short_answer",
      "prompt": "Say you can swim. Use can.",
      "accepted": [
        "I can swim",
        "I can swim well"
      ],
      "explanation": "Use I can + swim."
    }
  ]
}
