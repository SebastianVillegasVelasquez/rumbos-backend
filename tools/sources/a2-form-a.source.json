    {"source_number": 5, "section": "Listening", "section_weight": 25, "part": "A", "stem": "What time is breakfast?", "options": [{"label": "A", "text": "2:00"}, {"label": "B", "text": "7:00"}, {"label": "C", "text": "11:00"}], "key": "B", "audio_text": "Breakfast is at seven and the Wi-Fi password is MACIZO2026.", "competency": "M-I · 1.2 · datos de la estadía · listening"},
    {"source_number": 6, "section": "Listening", "section_weight": 25, "part": "B", "stem": "What is the technician doing?", "options": [{"label": "A", "text": "cleaning the room"}, {"label": "B", "text": "bringing breakfast"}, {"label": "C", "text": "fixing the heater"}], "key": "C", "audio_text": "— The water is cold! — I’m so sorry. The technician is fixing the heater right now.", "competency": "M-II · 2.1 · presente continuo · listening"},
    {"source_number": 7, "section": "Listening", "section_weight": 25, "part": "B", "stem": "What is the problem?", "options": [{"label": "A", "text": "a cold"}, {"label": "B", "text": "a headache"}, {"label": "C", "text": "an ankle injury"}], "key": "C", "audio_text": "— Where is the injury? — My ankle hurts. I can’t move my foot.", "competency": "M-II · 2.2 · salud/síntomas · listening"},
    {"source_number": 8, "section": "Listening", "section_weight": 25, "part": "B", "stem": "What advice does the host give?", "options": [{"label": "A", "text": "take many pills"}, {"label": "B", "text": "drink something warm"}, {"label": "C", "text": "go hiking"}], "key": "B", "audio_text": "— I have a sore throat. — I’m sorry to hear that. You should drink something warm.", "competency": "M-II · 2.2 · salud/síntomas · listening"},
    {"source_number": 9, "section": "Listening", "section_weight": 25, "part": "B", "stem": "Who can guide the night walk?", "options": [{"label": "A", "text": "Mateo"}, {"label": "B", "text": "the guest"}, {"label": "C", "text": "nobody"}], "key": "A", "audio_text": "— Can someone guide a night walk? — Yes, Mateo can guide it tonight.", "competency": "M-III · 3.2 · can · listening"},
    {"source_number": 10, "section": "Listening", "section_weight": 25, "part": "B", "stem": "How does the host answer the upset caller?", "options": [{"label": "A", "text": "hanging up"}, {"label": "B", "text": "shouting"}, {"label": "C", "text": "calmly and apologizing"}], "key": "C", "audio_text": "— Front desk, how can I help you? — Your booking is wrong! — I understand, I’m so sorry.", "competency": "M-III · 3.3 · teléfono/persona difícil · listening"},
